{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuleTrip report schema v1",
  "type": "object",
  "required": ["schemaVersion", "tool", "generatedAt", "source", "semantics", "conclusion", "counts", "guards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "RuleTrip" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["commit", "configPath"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "configPath": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "semantics": { "type": "object" },
    "conclusion": { "enum": ["alive", "dead", "broken", "inconclusive"] },
    "counts": {
      "type": "object",
      "required": ["alive", "dead", "broken", "inconclusive"],
      "properties": {
        "alive": { "type": "integer", "minimum": 0 },
        "dead": { "type": "integer", "minimum": 0 },
        "broken": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "required": ["sensorsConfigured", "sensorsMatched", "sensorsMissing", "sensorsUnattributed", "exitOnly"],
      "properties": {
        "sensorsConfigured": { "type": "integer", "minimum": 0 },
        "sensorsMatched": { "type": "integer", "minimum": 0 },
        "sensorsMissing": { "type": "integer", "minimum": 0 },
        "sensorsUnattributed": { "type": "integer", "minimum": 0 },
        "exitOnly": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "guards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "command", "status", "canaries"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "status": { "enum": ["alive", "dead", "broken", "inconclusive"] },
          "reason": { "type": ["string", "null"] },
          "baseline": { "type": ["object", "null"] },
          "baselineAttempts": { "type": "array", "items": { "type": "object" } },
          "confirmRuns": { "type": "integer", "minimum": 1, "maximum": 5 },
          "canaries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "type", "target", "status", "reason"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "type": { "enum": ["create", "append", "replace", "delete"] },
                "target": { "type": "string", "minLength": 1 },
                "status": { "enum": ["alive", "dead", "broken", "inconclusive"] },
                "reason": { "type": "string" },
                "execution": { "type": ["object", "null"] },
                "attempts": { "type": "array", "items": { "type": "object" } },
                "confirmation": {
                  "type": "object",
                  "required": ["requiredRuns", "completedRuns", "stable"],
                  "properties": {
                    "requiredRuns": { "type": "integer", "minimum": 1, "maximum": 5 },
                    "completedRuns": { "type": "integer", "minimum": 0, "maximum": 5 },
                    "stable": { "type": "boolean" }
                  },
                  "additionalProperties": false
                },
                "sensor": {
                  "type": "object",
                  "required": ["configured", "stream", "baselineClear", "baselineMatchedRuns", "mutationMatchedRuns", "matched"],
                  "properties": {
                    "configured": { "type": "boolean" },
                    "stream": { "enum": ["stdout", "stderr", "combined", null] },
                    "baselineClear": { "type": ["boolean", "null"] },
                    "baselineMatchedRuns": { "type": "integer", "minimum": 0, "maximum": 5 },
                    "mutationMatchedRuns": { "type": "integer", "minimum": 0, "maximum": 5 },
                    "matched": { "type": ["boolean", "null"] }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
